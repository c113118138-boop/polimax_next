[Unit]
Description=Import Apple FindMy location reports into POLIMAX PostgreSQL
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/polimax_next/.data/findmy/account.json

[Service]
Type=oneshot
WorkingDirectory=%h/polimax_next
ExecStart=%h/polimax_next/.venv-findmy/bin/python %h/polimax_next/integrations/findmy/findmyupdate.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
