# Copy to .env; credentials must not be committed.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=polimax
MYSQL_USER=polimax
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
# Existing production service stays on mysql until final cutover.
AMS_DATABASE_MODE=mysql
# For isolated PostgreSQL verification, set AMS_DATABASE_MODE=postgresql and fill:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=polimax_PostgreSQL
# POSTGRES_USER=polimax_admin
# POSTGRES_PASSWORD=
# Same PostgreSQL server/credentials; must differ from POSTGRES_DATABASE.
AMS_ARCHIVE_DATABASE=polimax_PostgreSQL_Expired
# Enable only after database creation, --initialize, preview and backup checks.
AMS_ARCHIVE_ENABLED=0
AMS_AUTH_MODE=sso
PREVIEW_LOGIN_ENABLED=0

SSO_SERVER=https://your-company-sso.example
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
PUBLIC_WEB_URL=https://polimax.example
# Defaults to PUBLIC_WEB_URL/api/callback; must match the registered SSO callback.
# SSO_REDIRECT_URI=https://polimax.example/api/callback

# Relative paths are resolved against this project, not the shell working directory.
AMS_DATA_DIR=.data
# Defaults: .data/responses, .data/permissions/latest-AMS.json, .data/files, .data/sso
# AMS_RESPONSES_DIR=.data/responses
# AMS_SSO_POLICY_MANIFEST=.data/permissions/latest-AMS.json
# Optional alternative to the snapshot; explicitly maintained account-to-role policy:
# AMS_POLICY_FILE=.data/permissions/policy.json
